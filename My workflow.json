    {
      "parameters": {
        "jsCode": "const data = $json;\n\nlet marks = [];\nlet weakModules = [];\n\nif (data[\"Course Type\"] === \"Data Analysis\") {\n  const modules = [\n    \"Python Programming\",\n    \"Exploratory Data Analysis with Python\",\n    \"MYSQL\",\n    \"Microsoft Power BI\",\n    \"Advanced Statistics\",\n    \"Microsoft Excel\"\n  ];\n\n  for (let module of modules) {\n    const score = Number(data[module]);\n\n    if (!isNaN(score)) {\n      marks.push(score);\n\n      if (score <= 70) {\n        weakModules.push(module);\n      }\n    }\n  }\n}\n\nif (data[\"Course Type\"] === \"Data Science with Generative AI\") {\n  const modules = [\n    \"Machine learning\",\n    \"Deep learning\",\n    \"ANN - Artificial Neural Networks\",\n    \"CNN - Convolutional Neural Networks\",\n    \"Computer Vision\",\n    \"NLP - Natural Language Processing\",\n    \"Generative AI\"\n  ];\n\n  for (let module of modules) {\n    const score = Number(data[module]);\n\n    if (!isNaN(score)) {\n      marks.push(score);\n\n      if (score <= 70) {\n        weakModules.push(module);\n      }\n    }\n  }\n}\n\nconst average = marks.reduce((a, b) => a + b, 0) / marks.length;\n\nreturn [\n  {\n    json: {\n      average: average.toFixed(2),\n      eligible: average > 70,\n      weakModules: weakModules.join(\", \")\n    }\n  }\n];"
      },
